{"hierarchy":{"paths":[["doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID","doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID\/DocumentCaptureModuleSettings"]]},"sections":[],"identifier":{"url":"doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID\/DocumentCaptureModuleSettings\/inputImageSelectionStrategy","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/blinkid\/documentcapturemodulesettings\/inputimageselectionstrategy"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","metadata":{"externalID":"s:7BlinkID29DocumentCaptureModuleSettingsV27inputImageSelectionStrategyAA05InputhiJ0Ovp","symbolKind":"property","role":"symbol","modules":[{"name":"BlinkID"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"inputImageSelectionStrategy","kind":"identifier"},{"text":": ","kind":"text"},{"text":"InputImageSelectionStrategy","kind":"typeIdentifier","preciseIdentifier":"s:7BlinkID27InputImageSelectionStrategyO"}],"roleHeading":"Instance Property","title":"inputImageSelectionStrategy"},"abstract":[{"type":"text","text":"Represents the strategy used to select the best input image from a pool of stable input images."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"inputImageSelectionStrategy","kind":"identifier"},{"text":": ","kind":"text"},{"text":"InputImageSelectionStrategy","identifier":"doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID\/InputImageSelectionStrategy","preciseIdentifier":"s:7BlinkID27InputImageSelectionStrategyO","kind":"typeIdentifier"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}]},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before selecting the best quality image, a sequence of stable input images must be available. From this pool of input images,"},{"type":"text","text":" "},{"type":"text","text":"the one with the highest quality is selected. An input image is considered stable if the image analysis results are consistent"},{"type":"text","text":" "},{"type":"text","text":"across consecutive stream of input images."}]},{"type":"paragraph","inlineContent":[{"text":"A larger pool size increases the likelihood of capturing a high-quality image but may introduce a slight delay,","type":"text"},{"text":" ","type":"text"},{"text":"as more stable input images need to be collected.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Available strategies are: ","type":"text"},{"code":"SingleImage","type":"codeVoice"},{"text":", ","type":"text"},{"code":"OptimizeForSpeed","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Balanced","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"OptimizeForQuality","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Default strategy represents a trade-off between speed and quality, while ","type":"text"},{"code":"OptimizeForSpeed","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"OptimizeForQuality"},{"text":" represent","type":"text"},{"text":" ","type":"text"},{"text":"strategies optimized for speed and quality, respectively.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This setting is applicable only for ","type":"text"},{"type":"codeVoice","code":"Video"},{"text":" input image source.","type":"text"}]}],"kind":"content"}],"references":{"doc://com.microblink.BlinkID/documentation/BlinkID/DocumentCaptureModuleSettings":{"identifier":"doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID\/DocumentCaptureModuleSettings","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DocumentCaptureModuleSettings","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"DocumentCaptureModuleSettings","kind":"identifier"}],"url":"\/documentation\/blinkid\/documentcapturemodulesettings","type":"topic","title":"DocumentCaptureModuleSettings","abstract":[{"type":"text","text":"Settings for the document capture module."}],"role":"symbol"},"doc://com.microblink.BlinkID/documentation/BlinkID":{"abstract":[],"identifier":"doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID","role":"collection","kind":"symbol","url":"\/documentation\/blinkid","type":"topic","title":"BlinkID"},"doc://com.microblink.BlinkID/documentation/BlinkID/InputImageSelectionStrategy":{"type":"topic","identifier":"doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID\/InputImageSelectionStrategy","url":"\/documentation\/blinkid\/inputimageselectionstrategy","title":"InputImageSelectionStrategy","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"InputImageSelectionStrategy","kind":"identifier"}],"navigatorTitle":[{"text":"InputImageSelectionStrategy","kind":"identifier"}],"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Represents the strategy used to select the best input image from a pool of stable input images."}]},"doc://com.microblink.BlinkID/documentation/BlinkID/DocumentCaptureModuleSettings/inputImageSelectionStrategy":{"identifier":"doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID\/DocumentCaptureModuleSettings\/inputImageSelectionStrategy","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"inputImageSelectionStrategy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"InputImageSelectionStrategy","preciseIdentifier":"s:7BlinkID27InputImageSelectionStrategyO"}],"kind":"symbol","type":"topic","url":"\/documentation\/blinkid\/documentcapturemodulesettings\/inputimageselectionstrategy","title":"inputImageSelectionStrategy","abstract":[{"text":"Represents the strategy used to select the best input image from a pool of stable input images.","type":"text"}],"role":"symbol"}}}