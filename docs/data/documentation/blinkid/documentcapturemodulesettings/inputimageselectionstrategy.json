{"variants":[{"paths":["\/documentation\/blinkid\/documentcapturemodulesettings\/inputimageselectionstrategy"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID\/DocumentCaptureModuleSettings\/inputImageSelectionStrategy","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID","doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID\/DocumentCaptureModuleSettings"]]},"metadata":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"inputImageSelectionStrategy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7BlinkID27InputImageSelectionStrategyO","text":"InputImageSelectionStrategy"}],"symbolKind":"property","title":"inputImageSelectionStrategy","roleHeading":"Instance Property","externalID":"s:7BlinkID29DocumentCaptureModuleSettingsV27inputImageSelectionStrategyAA05InputhiJ0Ovp","modules":[{"name":"BlinkID"}],"role":"symbol"},"abstract":[{"text":"Represents the strategy used to select the best input image from a pool of stable input images.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"inputImageSelectionStrategy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7BlinkID27InputImageSelectionStrategyO","text":"InputImageSelectionStrategy","identifier":"doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID\/InputImageSelectionStrategy"}]}]},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Before selecting the best quality image, a sequence of stable input images must be available. From this pool of input images,"},{"type":"text","text":" "},{"type":"text","text":"the one with the highest quality is selected. An input image is considered stable if the image analysis results are consistent"},{"type":"text","text":" "},{"type":"text","text":"across consecutive stream of input images."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A larger pool size increases the likelihood of capturing a high-quality image but may introduce a slight delay,"},{"type":"text","text":" "},{"type":"text","text":"as more stable input images need to be collected."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Available strategies are: "},{"code":"SingleImage","type":"codeVoice"},{"type":"text","text":", "},{"code":"OptimizeForSpeed","type":"codeVoice"},{"type":"text","text":", "},{"code":"Balanced","type":"codeVoice"},{"type":"text","text":" and "},{"code":"OptimizeForQuality","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Default strategy represents a trade-off between speed and quality, while "},{"code":"OptimizeForSpeed","type":"codeVoice"},{"type":"text","text":" and "},{"code":"OptimizeForQuality","type":"codeVoice"},{"type":"text","text":" represent"},{"type":"text","text":" "},{"type":"text","text":"strategies optimized for speed and quality, respectively."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This setting is applicable only for "},{"code":"Video","type":"codeVoice"},{"type":"text","text":" input image source."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://com.microblink.BlinkID/documentation/BlinkID/DocumentCaptureModuleSettings":{"kind":"symbol","abstract":[{"text":"Settings for the document capture module.","type":"text"}],"url":"\/documentation\/blinkid\/documentcapturemodulesettings","type":"topic","title":"DocumentCaptureModuleSettings","identifier":"doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID\/DocumentCaptureModuleSettings","fragments":