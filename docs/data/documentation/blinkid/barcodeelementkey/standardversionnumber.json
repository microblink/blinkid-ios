{"metadata":{"role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"standardVersionNumber","kind":"identifier"}],"modules":[{"name":"BlinkID"}],"symbolKind":"case","roleHeading":"Case","title":"BarcodeElementKey.standardVersionNumber","externalID":"s:7BlinkID17BarcodeElementKeyO21standardVersionNumberyA2CmF"},"sections":[],"variants":[{"paths":["\/documentation\/blinkid\/barcodeelementkey\/standardversionnumber"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID","doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID\/BarcodeElementKey"]]},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID\/BarcodeElementKey\/standardVersionNumber"},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Mandatory on all driver’s licenses."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"standardVersionNumber","kind":"identifier"}],"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"text":"AAMVA Version Number: This is a decimal value between 0 and 99 that","type":"text"},{"text":" ","type":"text"},{"text":"specifies the version level of the PDF417 bar code format. Version “0” and “00”","type":"text"},{"text":" ","type":"text"},{"text":"is reserved for bar codes printed to the specification of the American Association","type":"text"},{"text":" ","type":"text"},{"text":"of Motor Vehicle Administrators (AAMVA) prior to the adoption of the AAMVA DL\/ID-2000","type":"text"},{"text":" ","type":"text"},{"text":"standard.","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Al