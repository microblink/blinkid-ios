{"metadata":{"symbolKind":"property","title":"presenceMandatory","roleHeading":"Instance Property","externalID":"s:7BlinkID21BarcodeModuleSettingsV17presenceMandatorySbvp","modules":[{"name":"BlinkID"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"presenceMandatory","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"role":"symbol"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"presenceMandatory","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"For Single ScanningMode, the barcode must be present on the scanned side."},{"type":"text","text":" "},{"type":"text","text":"For Automatic ScanningMode, the barcode must be present on one of the scanned sides."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In case of a timeout and advancement to the next step in the scanning flow,"},{"type":"text","text":" "},{"type":"text","text":"if a barcode is detected on the scanned side but cannot be extracted,"},{"type":"text","text":" "},{"type":"text","text":"the presence requirement is considered fulfilled. As a result, barcode extraction"},{"type":"text","text":" "},{"type":"text","text":"will no longer be a requirement to complete the scan on next side."}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"If set to true, barcode presence becomes mandatory for the scanned document."}],"kind":"symbol","variants":[{"paths":["\/documentation\/blinkid\/barcodemodulesettings\/presencemandatory"],"traits":[{"interfaceLanguage":"swift"}]}],"identi