{"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Enables the scanning and processing of Pdf417 barcodes."}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID","doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID\/BarcodeModuleSettings"]]},"metadata":{"roleHeading":"Instance Property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"pdf417ScanningEnabled","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"externalID":"s:7BlinkID21BarcodeModuleSettingsV21pdf417ScanningEnabledSbvp","role":"symbol","title":"pdf417ScanningEnabled","modules":[{"name":"BlinkID"}],"symbolKind":"property"},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"pdf417ScanningEnabled"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The current analyzer model flags a barcode as “present” if either a "},{"code":"PDF417","type":"codeVoice"},{"type":"text","text":" or a "},{"code":"QR","type":"codeVoice"},{"type":"text","text":" code is detected."},{"type":"text","text":" "},{"type":"text","text":"Because the model does not distinguish between the two types at this stage, a conflict can occur:"},{"type":"text","text":" "},{"type":"text","text":"if "},{"code":"PDF417","type":"codeVoice"},{"type":"text","text":" is enabled but "},{"code":"QR","type":"codeVoice"},{"type":"text","text":" is disabled, the analyzer may trigger for a "},{"code":"QR","type":"codeVoice"},{"type":"text","text":" code, causing the process to hang."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To prevent this, "},{"type":"codeVoice","code":"pdf417ScanningEnabled"},{"type":"text","text":" and "},{"type":"codeVoice","code":"qrScanningEnabled"},{"type":"text","text":" must be enabled together."}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID\/BarcodeModuleSettings\/pdf417ScanningEnabled"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/blinkid\/barcodemodulesettings\/pdf417scanningenabled"]}],"references":{"doc://com.microblink.BlinkID/documentation/BlinkID/BarcodeModuleSettings/pdf417ScanningEnabled":{"identifier":"doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID\/BarcodeModuleSettings\/pdf417ScanningEnabled","url":"\/documentation\/blinkid\/barcodemodulesettings\/pdf417scanningenabled","role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"pdf417ScanningEnabled","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"abstract":[{"type":"text","text":"Enables the scanning and processing of Pdf417 barcodes."}],"title":"pdf417ScanningEnabled"},"doc://com.microblink.BlinkID/documentation/BlinkID/BarcodeModuleSettings":{"url":"\/documentation\/blinkid\/barcodemodulesettings","identifier":"doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID\/BarcodeModuleSettings","role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BarcodeModuleSettings","kind":"identifier"}],"navigatorTitle":[{"text":"BarcodeModuleSettings","kind":"identifier"}],"abstract":[{"text":"Settings for the barcode extraction module.","type":"text"}],"title":"BarcodeModuleSettings"},"doc://com.microblink.BlinkID/documentation/BlinkID":{"abstract":[],"identifier":"doc:\/\/com.microblink.BlinkID\/documentation\/BlinkID","role":"collec