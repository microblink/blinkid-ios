        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zorg ervoor dat het document goed verlicht is. Alle velden op het document moeten onder het camerascherm zichtbaar zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upewnij się, że dokument jest dobrze oświetlony. Wszystkie pola dokumentu powinny być widoczne na ekranie aparatu."
          }
        },
        "ps-AF" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ډاډ ترلاسه کړئ چې تاسو سند ښه روښانه ساتئ. د اسنادو ټولې ساحې باید د کیمرې په سکرین کې ښکاره شي."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assegure-se de que mantém o documento bem iluminado. Todos os campos do documento devem estar visíveis no ecrã da câmara."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certifique-se de manter o documento bem iluminado. Todos os campos do documento devem estar visíveis na tela da câmera."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asigurați-vă că documentul este bine iluminat. Toate secțiunile din document trebuie să fie vizibile pe ecranul camerei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сделайте так, чтобы документ был хорошо освещен. Все его поля должны быть видны на экране камеры."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ලේඛනයට හොඳින් ආලෝකය වැටෙන පරිදි තබා ගැනීමට වග බලා ගන්න. ලේඛනයේ සියලුම කොටස් කැමරා තිරය මත දෘශ්‍යමාන විය යුතු ය."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uistite sa, že máte dokument dobre osvetlený. Všetky polia dokumentu by mali byť viditeľné na obrazovke fotoaparátu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poskrbite, da bo dokument dobro osvetljen. Na zaslonu kamere morajo biti vidna vsa polja dokumenta."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uverite se da je dokument dobro osvetljen. Sva polja dokumenta treba da budu vidljiva na ekranu kamere."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se till att dokumentet är väl belyst. Alla fält i dokumentet ska synas på kameraskärmen."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hakikisha hati iko kwenye mwanga wa kutosha. Sehemu zote za hati zinapaswa kuonekana kwenye skrini ya kamera."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจสอบว่าเอกสารของคุณมีแสงสว่างเพียงพอ คุณควรมองเห็นทุกส่วนของเอกสารบนหน้าจอกล้อง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belgenin iyi aydınlatıldığından emin ol. Tüm belge alanları kamera ekranında görünür olmalıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переконайтеся, що документ добре освітлений. Усі поля документа мають бути видимими на екрані камери."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یقینی بنائیں کہ دستاویز اچھی طرح روشن ہو۔ دستاویز کے تمام خانے کیمرہ اسکرین پر واضح نظر آنے چاہئیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hujjat yetarlicha yoritilganiga ishonch hosil qiling. Hujjatning barcha maydonlari kamera ekranida koʻrinishi kerak."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đảm bảo rằng bạn giữ cho tài liệu được chiếu sáng tốt. Tất cả các trường tài liệu sẽ hiển thị trên màn hình camera."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ríi dájú pé ìmọ́lẹ̀ tàn sórí ìwé àkọsílẹ̀ náà dáadáa. Gbogbo ààyè orí ìwé àkọsílẹ̀ náà ni kó sí hàn kedere lórí àwo kámẹ́rà."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确保文件处于光线充足的地方。所有文件字段应在相机屏幕上可见。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確保文件光線充足。所有文件欄位在相機螢幕都應清楚可見。"
          }
        }
      }
    },
    "mb_onboarding_dialog_mrz_id_message" : {
      "comment" : "scan.onboarding.mrz.locate.message: ",
      "extractionState" : "manual",
      "localizations" : {
        "ak" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wubehu nkyerɛwde atenten bi wɔ krataa no ase wɔ n’anim anaa n’akyi, a wɔakyekyɛ mu ayɛ no nkyerɛwde 2 anaa 3 na wɔde aro (<< anaa >>) atew ntam."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በሰነዱ ፊት ወይም ጀርባ የታችኛው ክፍል ላይ፣ በ2 ወይም 3 መስመሮች የተከፈለና በቀስቶች (<< ወይም >>) የተለያየ ረጅም የቁምፊዎች ተርታ ያገኛሉ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستجد سلسلة طويلة من الأحرف في أسفل الصفحة الأمامية أو الخلفية للمستند، مقسمة إلى سطرين أو 3 أسطر ومفصولة بأسهم (<< أو >>)."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নথির সামনের বা পেছনের অংশের নিচের দিকে আপনি অক্ষর ও চিহ্নের একটি দীর্ঘ সারি দেখতে পাবেন, যা দুই বা তিনটি লাইনে বিভক্ত এবং তীরচিহ্ন (<< বা >>) দ্বারা আলাদা করা।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve spodní části přední či zadní strany dokumentu najdete dlouhý řetězec znaků, který je rozdělený do 2 nebo 3 řádků a přerušovaný šipkami (<< nebo >>)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du finder en lang række tegn nederst på forsiden eller bagsiden af dokumentet, opdelt i 2 eller 3 linjer og adskilt af pile (<< eller >>)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am unteren Rand der Vorder- oder Rückseite des Dokuments finden Sie eine lange Zeichenfolge. Sie ist in 2 oder 3 Zeilen geteilt und durch Pfeile (<< oder >>) getrennt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα βρείτε μια μεγάλη αλληλουχία χαρακτήρων στο κάτω μέρος της μπροστινής ή της πίσω πλευράς του εγγράφου, διαχωρισμένη σε 2 ή 3 γραμμές με βέλη (<< ή >>)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You’ll find a long string of characters at the bottom of the front or back of the document, split into 2 or 3 lines and separated by arrows (<< or >>)."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You’ll find a long string of characters at the bottom of the front or back of the document, split into 2 or 3 lines and separated by arrows (<< or >>)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la parte inferior de la parte frontal o del reverso del documento encontrarás una larga cadena de caracteres dividida en 2 o 3 líneas y separada por flechas (<< o >>)."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
