        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নিশ্চিত করুন যে নথিতে পর্যাপ্ত আলো রয়েছে, এটি সম্পূর্ণ দৃশ্যমান এবং এতে কোনো চকচকে ভাব নেই।"
