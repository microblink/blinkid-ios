        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የሰነዱ ቦታ በቂ ብርሃን እንደሚያገኝ፣ በደንብ እንደሚታይና ነጸብራቅ እንደሌለበት ያረጋግጡ።"
          }
