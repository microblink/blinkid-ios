    "mb_passport_help_open_passport_subtitle" : {
      "comment" : "scan.help.open_passport.message: Body text of the passport-only help step explaining which passport page the SDK needs.",
      "extractionState" : "manual",
      "localizations" : {
        "ak" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bue wo akwantuo krataa no kɔ krataafa a wo mfonini ne wo ho nsɛm wɔ so no so. Krataafa yi kyerɛ wo din, da a wɔwoo wo, wo akwantuo krataa nɔma, ne nsɛm afoforo a wɔde hu wo."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ፓስፖርትዎን ፎቶዎ እና የግል መረጃዎ ባሉበት ገጽ ላይ ይክፈቱ። ይህ ገጽ ስምዎን፣ የትውልድ ቀንዎን፣ የፓስፖርት ቁጥርዎን እና ሌሎች መለያ መረጃዎችን ያሳያል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح جواز سفرك على الصفحة التي تحتوي على صورتك وبياناتك الشخصية. تعرض هذه الصفحة اسمك وتاريخ ميلادك ورقم جواز سفرك وغيرها من المعلومات التعريفية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার ছবি ও ব্যক্তিগত তথ্য রয়েছে এমন পৃষ্ঠাটি খুলুন। এই পৃষ্ঠায় আপনার নাম, জন্মতারিখ, পাসপোর্ট নম্বর এবং অন্যান্য পরিচয়সংক্রান্ত তথ্য থাকে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevřete pas na stránce s fotografií a osobními údaji. Na této stránce je uvedeno vaše jméno, datum narození, číslo pasu a další identifikační údaje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn dit pas på siden med dit foto og dine personlige oplysninger. Denne side viser dit navn, din fødselsdato, dit pasnummer og andre identifikationsoplysninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie Ihren Reisepass auf der Seite mit Ihrem Foto und Ihren persönlichen Daten. Auf dieser Seite stehen Ihr Name, Ihr Geburtsdatum, Ihre Reisepassnummer und weitere Angaben zu Ihrer Person."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανοίξτε το διαβατήριό σας στη σελίδα με τη φωτογραφία και τα προσωπικά σας στοιχεία. Σε αυτή τη σελίδα εμφανίζονται το όνομά σας, η ημερομηνία γέννησής σας, ο αριθμός διαβατηρίου σας και άλλα στοιχεία ταυτοποίησης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open your passport to the page with your photo and personal details. This page shows your name, date of birth, passport number, and other identifying information."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open your passport to the page with your photo and personal details. This page shows your name, date of birth, passport number and other identifying information."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra el pasaporte en la página con su foto y datos personales. En esta página aparecen su nombre, fecha de nacimiento, número de pasaporte y otros datos identificativos."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra su pasaporte en la página con su foto y datos personales. Esta página muestra su nombre, fecha de nacimiento, número de pasaporte y otra información de identificación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gozarnameye khod ra be safhe-i baz konid ke aks va etelaate shakhsitan dar an ast. In safhe nam, tarikhe tavalod, shomareye gozarname va digar etelaate hoviyati shoma ra neshan midahad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa passi sivulle, jolla ovat valokuvasi ja henkilötietosi. Sivulla näkyvät nimesi, syntymäaikasi, passinumerosi ja muut tunnistetietosi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buksan ang iyong pasaporte sa pahinang may larawan at personal na detalye. Makikita sa pahinang ito ang iyong pangalan, petsa ng kapanganakan, numero ng pasaporte, at iba pang impormasyong tumutukoy sa iyong pagkakakilanlan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez votre passeport à la page comportant votre photo et vos informations personnelles. Cette page indique votre nom, votre date de naissance, votre numéro de passeport et d’autres informations d’identité."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez votre passeport à la page où figurent votre photo et vos renseignements personnels. Cette page indique votre nom, votre date de naissance, votre numéro de passeport et d’autres renseignements d’identification."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buɗe fasfonku zuwa shafin da ke ɗauke da hotonku da bayananku na sirri. Wannan shafin yana nuna sunanku, ranar haihuwarku, lambar fasfo, da sauran bayanan tantancewa."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פתחו את הדרכון בעמוד שבו מופיעים התמונה והפרטים האישיים שלכם. בעמוד זה מופיעים שמכם, תאריך הלידה, מספר הדרכון ופרטים מזהים נוספים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना पासपोर्ट उस पृष्ठ पर खोलें जिसमें आपकी फ़ोटो और व्यक्तिगत जानकारी हो। इस पृष्ठ पर आपका नाम, जन्मतिथि, पासपोर्ट नंबर और अन्य पहचान संबंधी जानकारी होती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvorite putovnicu na stranici s fotografijom i osobnim podacima. Na toj se stranici nalaze vaše ime, datum rođenja, broj putovnice i drugi identifikacijski podaci."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyissa ki az útlevelét a fényképét és személyes adatait tartalmazó oldalnál. Ezen az oldalon szerepel a neve, születési ideje, útlevélszáma és más azonosító adatai."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka paspor Anda pada halaman yang memuat foto dan data pribadi Anda. Halaman ini menampilkan nama, tanggal lahir, nomor paspor, dan informasi identitas lainnya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opnaðu vegabréfið á síðunni með myndinni þinni og persónuupplýsingum. Á þessari síðu eru nafn þitt, fæðingardagur, vegabréfsnúmer og aðrar upplýsingar sem auðkenna þig."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri il passaporto alla pagina con la foto e i dati personali. Questa pagina riporta il tuo nome, la data di nascita, il numero di passaporto e altre informazioni identificative."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスポートの顔写真と個人情報が記載されたページを開いてください。このページには、氏名、生年月日、パスポート番号などの本人確認情報が記載されています。"
          }
        },
        "ka-GE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "გადაშალეთ პასპორტი იმ გვერდზე, სადაც თქვენი ფოტო და პირადი მონაცემებია. ამ გვერდზე მითითებულია თქვენი სახელი, დაბადების თარიღი, პასპორტის ნომერი და სხვა საიდენტიფიკაციო ინფორმაცია."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Төлқұжатыңызды фотосуретіңіз бен жеке деректеріңіз бар бетке ашыңыз. Бұл бетте атыңыз, туған күніңіз, төлқұжат нөміріңіз және басқа да сәйкестендіру ақпараты көрсетілген."
          }
        },
        "km-KH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "បើកលិខិតឆ្លងដែនរបស់អ្នកទៅទំព័រដែលមានរូបថត និងព័ត៌មានផ្ទាល់ខ្លួនរបស់អ្នក។ ទំព័រនេះបង្ហាញឈ្មោះ ថ្ងៃខែឆ្នាំកំណើត លេខលិខិតឆ្លងដែន និងព័ត៌មានសម្គាល់អត្តសញ្ញាណផ្សេងទៀតរបស់អ្នក។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여권의 사진과 개인정보가 있는 페이지를 펼치세요. 이 페이지에는 이름, 생년월일, 여권 번호 및 기타 신원 정보가 표시되어 있습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atveriet pasi lapā ar savu fotoattēlu un personas datiem. Šajā lapā ir norādīts jūsu vārds, dzimšanas datums, pases numurs un cita identifikācijas informācija."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka pasport anda pada halaman yang memaparkan foto dan maklumat peribadi anda. Halaman ini memaparkan nama, tarikh lahir, nombor pasport dan maklumat pengenalan lain."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpne passet på siden med bildet ditt og personopplysningene dine. Denne siden viser navnet ditt, fødselsdatoen, passnummeret og annen identifiserende informasjon."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फोटो र व्यक्तिगत विवरण भएको पृष्ठमा आफ्नो राहदानी खोल्नुहोस्। यस पृष्ठमा तपाईंको नाम, जन्ममिति, राहदानी नम्बर र अन्य पहिचानसम्बन्धी जानकारी हुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open uw paspoort op de pagina met uw foto en persoonsgegevens. Op deze pagina staan uw naam, geboortedatum, paspoortnummer en andere identificerende gegevens."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz paszport na stronie ze zdjęciem i danymi osobowymi. Na tej stronie znajdują się Twoje imię i nazwisko, data urodzenia, numer paszportu oraz inne dane identyfikacyjne."
          }
        },
        "ps-AF" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "د خپل پاسپورټ هغه پاڼه پرانیزئ چې عکس او شخصي معلومات مو پکې دي. دا پاڼه ستاسو نوم، د زېږون نېټه، د پاسپورټ شمېره او نور د پېژندنې معلومات ښيي."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra o passaporte na página com a sua fotografia e os seus dados pessoais. Esta página apresenta o seu nome, a data de nascimento, o número do passaporte e outras informações de identificação."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra seu passaporte na página com sua foto e seus dados pessoais. Essa página mostra seu nome, data de nascimento, número do passaporte e outras informações de identificação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deschideți pașaportul la pagina cu fotografia și datele dumneavoastră personale. Această pagină conține numele, data nașterii, numărul pașaportului și alte informații de identificare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте паспорт на странице с фотографией и личными данными. На этой странице указаны ваше имя, дата рождения, номер паспорта и другие идентификационные данные."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබගේ විදේශ ගමන් බලපත්‍රය, ඔබගේ ඡායාරූපය සහ පුද්ගලික තොරතුරු ඇති පිටුවට විවෘත කරන්න. මෙම පිටුවේ ඔබගේ නම, උපන් දිනය, විදේශ ගමන් බලපත්‍ර අංකය සහ වෙනත් හඳුනාගැනීමේ තොරතුරු ඇත."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvorte pas na strane s vašou fotografiou a osobnými údajmi. Na tejto strane je uvedené vaše meno, dátum narodenia, číslo pasu a ďalšie identifikačné údaje."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odprite potni list na strani s fotografijo in osebnimi podatki. Na tej strani so vaše ime, datum rojstva, številka potnega lista in drugi identifikacijski podatki."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvorite pasoš na stranici sa fotografijom i ličnim podacima. Na toj stranici nalaze se vaše ime, datum rođenja, broj pasoša i drugi podaci za identifikaciju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna passet på sidan med ditt foto och dina personuppgifter. På den här sidan finns ditt namn, födelsedatum, passnummer och annan identifierande information."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fungua pasipoti yako kwenye ukurasa wenye picha na maelezo yako binafsi. Ukurasa huu unaonyesha jina lako, tarehe ya kuzaliwa, nambari ya pasipoti na maelezo mengine ya utambulisho."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดหนังสือเดินทางไปที่หน้าที่มีรูปถ่ายและข้อมูลส่วนบุคคลของคุณ หน้านี้จะแสดงชื่อ วันเกิด หมายเลขหนังสือเดินทาง และข้อมูลระบุตัวตนอื่นๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasaportunuzu, fotoğrafınızın ve kişisel bilgilerinizin bulunduğu sayfayı gösterecek şekilde açın. Bu sayfada adınız, doğum tarihiniz, pasaport numaranız ve diğer kimlik bilgileriniz yer alır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкрийте паспорт на сторінці з фотографією та особистими даними. На цій сторінці вказано ваше ім’я, дату народження, номер паспорта та інші ідентифікаційні дані."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنا پاسپورٹ اس صفحے پر کھولیں جس پر آپ کی تصویر اور ذاتی معلومات موجود ہوں۔ اس صفحے پر آپ کا نام، تاریخِ پیدائش، پاسپورٹ نمبر اور دیگر شناختی معلومات درج ہوتی ہیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasportingizning fotosuratingiz va shaxsiy ma’lumotlaringiz joylashgan sahifasini oching. Bu sahifada ismingiz, tug‘ilgan sanangiz, pasport raqamingiz va shaxsni aniqlovchi boshqa ma’lumotlar ko‘rsatilgan."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở hộ chiếu đến trang có ảnh và thông tin cá nhân của bạn. Trang này có họ tên, ngày sinh, số hộ chiếu và các thông tin nhận dạng khác."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ṣí ìwé ìrìnnà rẹ sí ojú-ewé tí ó ní fọ́tò rẹ àti àwọn ìwífún ti ara ẹni. Ojú-ewé yìí ní orúkọ rẹ, ọjọ́ ìbí, nọ́mbà ìwé ìrìnnà, àti àwọn ìwífún ìdánimọ̀ míì."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请打开护照，翻到包含照片和个人信息的页面。该页面显示您的姓名、出生日期、护照号码和其他身份信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請將護照翻到包含相片和個人資料的頁面。此頁面會顯示您的姓名、出生日期、護照號碼及其他身分識別資訊。"
          }
        }
      }
    },
