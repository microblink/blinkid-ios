        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ujistěte se, že je dokument dobře osvětlený, zcela viditelný a bez odlesků."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sørg for, at dokumentet er godt belyst og fuldt ud synligt, samt at der ikke er noget genskin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achten Sie darauf, dass das Dokument gut belichtet und vollständig sichtbar ist und nicht blendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βεβαιωθείτε ότι το έγγραφο είναι καλά φωτισμένο, πλήρως ορατό και δεν έχει αντανακλάσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure the document is well lit, fully visible, and free of glare."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure the document is well lit, fully visible and free from glare."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegúrate de que el documento esté bien iluminado, se vea completamente y no haya reflejos."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegúrese de que el documento esté bien iluminado, completamente visible y libre de reflejos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motmaen shavid sanad khub roshan, kamelan namayan va bedun-e tabesh ast."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmista, että asiakirja on hyvin valaistu, se näkyy kokonaisuudessaan eikä siinä ole heijastuksia."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siguraduhing sapat na naiilawan ang dokumento, ganap na nakikita, at walang glare."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assurez-vous que le document est bien éclairé, entièrement visible et sans reflet."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez que le document est bien éclairé, entièrement visible et exempt de reflets."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabbatar cewa an haska takardar da kyau, ana gani cikakke, kuma ba wani dishi-dishi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ודא שהמסמך מואר היטב, גלוי לחלוטין ולא מוסתר כלל ע\"י בוהק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुनिश्चित करें कि दस्तावेज़ पर अच्छी रोशनी हो, वह पूरा दिख रहा हो और किसी भी तरह की चमक से मुक्त हो।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pripazite da je dokument dobro osvijetljen, u potpunosti vidljiv i bez odsjaja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ügyeljen rá, hogy az okmány jól meg legyen világítva, teljesen látható legyen és ne legyen rajta becsillanás."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastikan dokumen cukup terang, terlihat sepenuhnya, dan bebas dari silau cahaya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gakktu úr skugga um að skjalið sé vel upplýst, fulllega sýnilegt og laust við endurskin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assicurati che il documento sia ben illuminato, interamente visibile e senza riflessi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書類全体が十分に明るく写り、すべてが画面内に収まり、反射がないことを確認してください。"
          }
        },
        "ka-GE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დარწმუნდით, რომ დოკუმენტი კარგად არის განათებული, სრულად ჩანს კადრში და არ აქვს ანარეკლი."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Құжатты жарық жерге, толықтай көрінетінін және жарық шағылыспайтын жерге қойыңыз."
          }
        },
        "km-KH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ត្រូវប្រាកដថា ឯកសារភ្លឺច្បាស់ មើលឃើញពេញ និងគ្មានចំណាំងពន្លឺ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문서에 빛이 충분하고, 전체가 보이며, 빛이 반사되지 않는지 확인하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pārliecinieties, ka dokuments ir labi apgaismots, pilnībā redzams un to neietekmē atspīdums."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastikan dokumen mempunyai pencahayaan yang mencukupi, kelihatan sepenuhnya dan bebas daripada silau."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sørg for at dokumentet er godt opplyst, helt synlig og uten gjenskinn."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कागजात पर्याप्त उज्यालोमा रहेको, पूर्ण रूपमा देखिएको र नचम्किएको हुनुपर्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zorg ervoor dat het document goed verlicht en volledig zichtbaar is en of er geen schitteringen op te zien zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upewnij się, że dokument jest dobrze oświetlony, w pełni widoczny i bez odblasków."
          }
        },
        "ps-AF" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ډاډ حاصل کړئ چې سند ښه روښانه، په بشپړ ډول د لیدو وړ دی او هېڅ د رڼا وړانګې پرې نشته."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garanta que o documento esteja bem iluminado, totalmente visível e sem reflexos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certifique-se de que o documento esteja bem iluminado, totalmente visível e sem reflexos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asigurați-vă că documentul este bine iluminat, vizibil în întregime și fără nicio reflexie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убедитесь, что документ хорошо освещен, полностью виден и нет бликов."
