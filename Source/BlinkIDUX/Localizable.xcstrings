    "mb_recognition_timeout_dialog_message" : {
      "comment" : "scan.error.unsuccessful.message.document: ",
      "extractionState" : "manual",
      "localizations" : {
        "ak" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hwɛ hu sɛ nkekae biara nni krataa no so, wotumi hu no yiye, na asum biara nni so."
          }
