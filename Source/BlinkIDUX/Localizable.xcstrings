    "mb_onboarding_dialog_barcode_message" : {
      "comment" : "scan.onboarding.barcode.locate-scan.message.desktop: ",
      "extractionState" : "manual",
      "localizations" : {
        "ak" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hwehwɛ barkodu (lines tuntum bebree anaa koodu a ayɛ sokwɛɛ). Hwɛ sɛ fi biara nni wo kamara no ani na wotumi hu barkodu no yiye."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ባርኮድ ይፈልጉ (ተከታታይ ጥቁር መስመሮች ወይም አራት ማዕዘን ኮድ)። የካሜራ ሌንስዎ ንጹህ መሆኑን እና ባርኮዱ በደንብ ብርሃን እንደሚያገኝ ያረጋግጡ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابحث عن الباركود (سلسلة من الخطوط السوداء أو رمز مربع). احرص على نظافة عدسة الكاميرا وإضاءة الباركود جيداً."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি বারকোড খুঁজুন (কালো রেখার সারি বা একটি বর্গাকার কোড)। নিশ্চিত করুন যেন আপনার ক্যামেরার লেন্সটি পরিষ্কার থাকে এবং বারকোডটিতে পর্যাপ্ত আলো পড়ে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najděte čárový kód (řadu černých čar nebo čtvercový kód). Ujistěte se, že je objektiv fotoaparátu čistý a čárový kód je dobře osvětlený."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find stregkoden (en række sorte streger eller en firkantet kode). Sørg for, at kameralinsen er ren, og at stregkoden er velbelyst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suchen Sie nach einem Barcode (eine Reihe schwarzer Linien oder ein quadratischer Code). Sorgen Sie dafür, dass Ihr Kameraobjektiv sauber ist und das Dokument gut belichtet ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εντοπίστε τον γραμμωτό κώδικα (μια σειρά μαύρων γραμμών ή έναν τετράγωνο κώδικα). Βεβαιωθείτε ότι ο φακός της κάμερας είναι καθαρός και ο γραμμωτός κώδικας καλά φωτισμένος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look for a barcode (a series of black lines or a square code). Make sure you keep your camera lens clean and the barcode well lit."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look for a barcode (a series of black lines or a square code). Make sure you keep your camera lens clean and the barcode well lit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca un código de barras (una serie de líneas negras o un código cuadrado). Asegúrate de que la lente de la cámara esté limpia y de que el código de barras esté bien iluminado."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busque un código de barras (una serie de líneas negras o un código cuadrado), Asegúrese de mantener el lente de su cámara limpio y el código de barras bien iluminado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barkod ra peida konid (reshte'i az khat-haye siah ya yek kode morabba'). Motma'en shavid ke lens-e dowbinetan tamiz va barkod khub roshan ast."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etsi viivakoodi (sarja mustia viivoja tai neliönmuotoinen koodi). Varmista, että kameran linssi on puhdas ja viivakoodi hyvin valaistu."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanapin ang barcode (isang series ng itim na linya o parisukat na code). Siguraduhing malinis ang lens ng camera mo at lubos na naiilawan ang barcode."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cherchez un code-barres (une série de lignes noires ou un code carré). Assurez-vous que l’objectif de votre appareil photo est propre et que le code-barres est bien éclairé."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherchez un code-barres (une série de lignes noires ou un code carré). Assurez-vous que l'objectif de votre appareil photo est propre et le code-barres bien éclairé."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A duba barcode (jerin baƙaƙen layuka ko baƙin zane da yake cikin tsarin akwati). Ku tabbatar da cewa babu datti a kan gilashin kamerarku sannan a haska barcode ɗin yadda ya kamata."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חפשו ברקוד (סדרה של קווים שחורים או קוד מרובע). ודאו שאתם שומרים על עדשת המצלמה נקייה ושהברקוד מואר היטב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बारकोड खोजें (काली रेखाओं की एक श्रृंखला या एक चौकोर कोड)। सुनिश्चित करें कि आपके कैमरे का लेंस साफ हो और बारकोड अच्छी तरह रोशन हो।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potražite barkod (niz crnih linija ili kvadratni kod). Pazite da je kamera čista i barkod dobro osvijetljen."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keressen vonalkódot (több egymás melletti vékony vonal vagy négyzet alakú kód). Ügyeljen rá, hogy a kamera lencséja tiszta és a vonalkód jól megvilágított legyen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cari kode batang (deretan garis hitam atau kode berbentuk kotak). Pastikan lensa kamera bersih dan kode batang cukup terang."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leitaðu að strikamerki (röð af svörtum línum eða ferköntuðum kóða). Gakktu úr skugga um að linsan á myndavélinni sé hrein og að strikamerkið sé vel upplýst."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca un codice a barre (una serie di linee nere o un codice QR). Assicurati di mantenere pulita la lente della fotocamera e che il codice a barre sia ben illuminato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バーコード（黒い線が並んだものまたは四角いコード）を探してください。カメラのレンズを清潔に保ち、バーコードが十分明るくなるようにしてください。"
          }
        },
        "ka-GE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მოძებნეთ შტრიხკოდი (შავი ხაზების სერია ან ოთხკუთხედი კოდი). დარწმუნდით, რომ კამერის ლინზა სუფთაა და შტრიხკოდი კარგადა არის განათებული."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Штрихкодты (қара сызықтар қатары немесе квадраттық код) табыңыз. Камераңыздың объективі таза және штрихкод жақсы жарықтандырылғанына көз жеткізіңіз."
          }
        },
        "km-KH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "រកមើលបារកូដ (ស៊េរីនៃខ្សែបន្ទាត់ខ្មៅ ឬកូដរាងការេ)។ ត្រូវប្រាកដថា អ្នករក្សាកញ្ចក់កាមេរ៉ាអ្នកស្អាត ហើយបារកូដត្រូវបានបំភ្លឺបានយ៉ាងល្អ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "바코드(검은 선이 나열된 형태 또는 사각형 코드)를 찾으세요. 카메라 렌즈를 깨끗하게 유지하고 바코드에 빛이 충분히 비치도록 하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meklējiet svītrkodu (vairākas melnas līnijas vai kvadrātkodu). Pārliecinieties, ka kameras objektīvs ir tīrs, un svītrkods ir labi apgaismots."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cari kod bar (satu siri garisan hitam atau kod berbentuk segi empat). Pastikan lensa kamera anda bersih dan kod bar mendapat pencahayaan yang baik."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se etter en strekkode (sorte vertikale streker eller en firkantet kode). Sørg for at kameralinsen er ren og at strekkoden er godt opplyst."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बारकोड (कालो धर्काहरू भएको वा वर्गाकार कोड) खोज्नुहोस्। आफ्नो क्यामेराको लेन्स सफा राख्नुहोस् र बारकोडमा पर्याप्त उज्यालो पार्नुहोस्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoek naar een barcode (een rij zwarte lijntjes of een vierkante code). Zorg ervoor dat de cameralens schoon is de barcode goed belicht is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znajdź kod kreskowy (seria czarnych linii lub kod kwadratowy). Upewnij się, że obiektyw aparatu jest czysty, a kod kreskowy dobrze oświetlony."
          }
        },
        "ps-AF" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بارکوډ وګورئ (د تورو کرښو یوه لړۍ یا یوه مربع شکله کوډ). ډاډ حاصل کړئ چې ستاسو د کامرې لېنز پاک دی او بارکوډ ښه روښانه وي."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procure um código de barras (uma série de linhas pretas ou um código quadrado). Mantenha a lente da sua câmara limpa e o código de barras bem iluminado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procure um código de barras (uma sequência de linhas pretas ou um código quadrado). Certifique-se de manter a lente da câmera limpa e o código de barras bem iluminado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Căutați un cod de bare (o serie de linii negre sau un cod în formă pătrată). Asigurați-vă că obiectivul camerei este curat, iar codul de bare este bine iluminat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найдите штрихкод (ряд черных линий или квадратный код). Убедитесь, что объектив чистый, а штрихкод хорошо подсвечен."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "බාර්කෝඩ් එකක් (කළු රේඛා පෙළක් හෝ සමචතුරශ්‍රාකාර කේතයක්) ඇති තැන සොයා ගන්න. ඔබේ කැමරා කාචය පිරිසිදුව ඇති බවත් බාර්කෝඩ් එකට හොඳින් ආලෝකය වැටෙන බවත් සහතික කර ගන්න."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyhľadajte čiarový kód (sériu čiernych čiar alebo štvorcový kód). Uistite sa, že je objektív fotoaparátu čistý a čiarový kód dobre osvetlený."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poiščite črtno kodo (niz črnih črt ali kvadratno kodo). Poskrbite, da bo objektiv kamere čist in da bo črtna koda dobro osvetljena."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pronađite bar-kod (niz crnih linija ili kvadratni kôd). Uverite se da je objektiv kamere čist i da je bar-kod dobro osvetljen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leta efter en streckkod (en serie svarta linjer eller en fyrkantig kod). Se till att hålla kameralinsen ren och streckkoden väl upplyst."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tafuta msimbopau (mfululizo wa mistari mieusi au msimbo mraba). Hakikisha lenzi za kamera yako ni safi na msimbopau uko kwenye mwanga wa kutosha."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หาบาร์โค้ด (กลุ่มเส้นหลายๆ ขีดหรือรหัสแบบสี่เหลี่ยม) ตรวจสอบว่าเลนส์กล้องของคุณสะอาดและสามารถมองเห็นรหัสบาร์โค้ดได้ชัดเจนดี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir barkod (siyah çizgilerden oluşan bir dizi veya bir karekod) arayın. Kamera lensinizin temiz ve barkodun iyi aydınlatılmış olduğundan emin olun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знайдіть штрих-код (ряд чорних ліній або квадратний код). Переконайтеся, що об'єктив камери чистий, а документ добре освітлений."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بار کوڈ تلاش کریں (سیاہ لائنز کی ایک سیریز یا مربع نما کوڈ)۔ یقینی بنائیں کہ آپ کے کیمرے کا لینز صاف ہو اور بار کوڈ مناسب روشنی میں ہو۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shtrix-kodni toping (qora chiziqlar qatori yoki kvadrat ichidagi kod). Kamerangiz obyektivi toza va shtrix-kod yaxshi yoritilgan boʻlsin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tìm mã vạch (một dãy các đường kẻ đen hoặc mã vuông). Đảm bảo rằng ống kính camera của bạn sạch và mã vạch được chiếu sáng tốt."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ṣàwarí kóòdù onílà kan (àwọn ilà dúdú tó wà ní àtẹ̀léra tàbí kóòdù kan nínú àpótí onígun mẹ́rin). Ríi dájú pé awò ojú kámẹ́rà rẹ mọ́ kí òye iná sì tàn sí kóòdù onílà náà dáadáa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查找条形码（一系列黑色线条或一个方形码）。确保相机镜头清洁且条形码光线充足。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請找到條碼（黑色線條組成的條碼或方形 QR 碼）。確保相機鏡頭清晰乾淨，且條碼處於光線充足的環境中。"
          }
        }
      }
    },
