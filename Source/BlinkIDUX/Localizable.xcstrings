    "mb_onboarding_dialog_barcode_id_message" : {
      "comment" : "scan.onboarding.barcode.locate.message: ",
      "extractionState" : "manual",
      "localizations" : {
        "ak" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebia nkrataa ahorow betumi awɔ baakoodu fɔmat ne mmeae ahorow. Hwɛ krataa no anim ne akyi sɛ wobehu baakoodu a."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "የተለያዩ የሰነድ አይነቶች የተለያየ የባርኮድ ቅርጽና መገኛ ቦታ ሊኖራቸው ይችላል። ባርኮድ መኖሩን ለማረጋገጥ የሰነዱን የፊትና የጀርባ ገጽ ይመልከቱ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد تحتوي أنواع المستندات المختلفة على صيغ وأماكن مختلفة للرموز الشريطية. ابحث عن الرمز الشريطي في وجه المستند وظهره."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বিভিন্ন ধরণের নথিপত্রে বারকোডের বিন্যাস ও অবস্থান ভিন্ন হতে পারে। বারকোডটি খুঁজে পেতে নথিপত্রটির সামনের ও পেছনের অংশ দেখুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Různé typy dokumentů se mohou lišit formátem a umístěním čárového kódu. Kód může být jak na přední, tak na zadní straně dokumentu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forskellige typer dokumenter kan have forskellige stregkodeformater og -placeringer. Se på forsiden og bagsiden af dokumentet for at finde en stregkode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiedene Arten von Dokumenten können unterschiedliche Barcodeformate und -positionen haben. Suchen Sie auf der Vorder- und Rückseite des Dokuments nach einem Barcode."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαφορετικοί τύποι εγγράφων ενδέχεται να περιέχουν διαφορετική μορφή και θέση γραμμωτών κωδικών. Κοιτάξτε στην μπροστινή και την πίσω όψη του εγγράφου για τον γραμμωτό κώδικα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Different types of documents may have different barcode formats and locations. Look at the front and back of the document for a barcode."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Different types of documents may have different barcode formats and locations. Look at the front and back of the document for a barcode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada tipo de documento puede tener un formato y una ubicación del código de barras diferente. Busca el código de barras tanto en la parte frontal como en el reverso del documento."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diferentes tipos de documentos pueden tener diferentes formatos de códigos de barras y ubicaciones. Revise el frente y reverso del documento para verificar si tiene un código de barras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No'e mostanad-ha momken ast format-ha va mahall-haye barkod-e mokhtalefi dashte bashand. Ru va pusht-e mostanad ra baraye barkod barrasi konid."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erityyppisten asiakirjojen viivakoodin muoto ja sijainti saattavat vaihdella. Etsi viivakoodi tarkistamalla asiakirjan etu- ja kääntöpuoli."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maaaring may iba't ibang format at lokasyon ng barcode ang iba't ibang uri ng mga dokumento. Tingnan ang harap at likod ng dokumento para sa barcode."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les différents types de documents peuvent avoir des formats et des emplacements de codes-barres différents. Examinez le recto et le verso du document à la recherche d’un code-barres."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les différents types de document peuvent posséder des formats et des emplacements de code-barres distincts. Vérifiez la présence d'un code-barres au recto et au verso du document."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takardu mabambanta suna iya zuwa da tsarin barcode mabambanta sanan da wuri daban-daban. A duba gaba da bayan takardar don barcode ɗin."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לסוגים שונים של מסמכים עשויים להיות פורמטים ומיקומים שונים של ברקוד. חפשו ברקוד בחלק הקדמי והאחורי של המסמך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विभिन्न प्रकार के दस्तावेज़ों में बारकोड के फार्मेट और स्थान अलग-अलग हो सकते हैं। बारकोड के लिए दस्तावेज़ के आगे और पीछे दोनों तरफ देखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Različite vrste dokumenata mogu imati različite formate i položaje barkoda. Provjerite prednju i stražnju stranu dokumenta kako biste pronašli barkod."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A különböző típusú okmányok eltérő vonalkód-formátummal és -helyekkel rendelkezhetnek. Nézze meg az okmány elejét és hátulját, hogy megtalálja a vonalkódot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jenis dokumen berbeda dapat memiliki format dan lokasi kode batang yang berbeda juga. Lihat sisi depan dan belakang dokumen untuk menemukannya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mismunandi gerðir skjala geta haft mismunandi strikamerkjasnið og staðsetningar. Leitaðu að strikamerki á fram- og bakhlið skjalsins."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diversi tipi di documenti possono riportare codici a barre con formati e posizioni differenti. Cerca un codice a barre sul fronte e sul retro del documento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書類の種類によって、バーコードの形式や位置は異なる場合があります。書類の表面と裏面を確認し、バーコードを探してください。"
          }
        },
        "ka-GE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სხვადასხვა ტიპის დოკუმენტს შეიძლება სხვადასხვა ფორმატის შტრიხკოდი ჰქონდეს და ის სხვადასხვა ადგილას იყოს განთავსებული. დაათვალიერეთ დოკუმენტის წინა და უკანა მხარეები შტრიხკოდის საპოვნელად."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Әр түрлі құжаттарда штрих-кодтың пішімі мен орналасуы әртүрлі болуы мүмкін. Құжаттың екі бетінен штрих-кодты іздеп көріңіз."
          }
        },
        "km-KH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ប្រភេទឯកសារខុសគ្នាអាចនឹងមានទ្រង់ទ្រាយបារកូដ និងទីតាំងខុសគ្នា។ សូមពិនិត្យផ្នែកខាងមុខ និងខាងក្រោយនៃឯកសាររកមើលបារកូដ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문서 종류에 따라 바코드 형식과 위치가 다를 수 있습니다. 문서 앞뒤에서 바코드를 확인하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dažādiem dokumentiem var būt dažādi svītrkoda formāti un atrašanās vietas. Lai atrastu svītrkodu, aplūkojiet dokumenta priekšpusi un aizmuguri."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jenis dokumen yang berbeza mungkin mempunyai format dan lokasi kod bar yang berbeza. Lihat bahagian depan dan belakang dokumen untuk kod bar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulike typer dokumenter kan ha strekkoder i ulike formater og på ulike steder. Se etter en strekkode både på forsiden og baksiden av dokumentet."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कागजात अनुसार बारकोडको रूप र यो कहाँ हुन्छ भन्ने कुरा फरक पर्न सक्छ। त्यसैले, बारकोड खोज्नका लागि आफ्नो कागजातको अगाडि र पछाडि दुवैतिर राम्ररी हेर्नुहोस्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschillende soorten documenten kunnen verschillende formaten en locaties van de streepjescode hebben. Kijk op de voor- en achterzijde van het document voor een streepjescode."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Różne typy dokumentów mogą mieć odmienne formaty kodów kreskowych oraz ich umiejscowienie. Obejrzyj przód i tył dokumentu, aby znaleźć kod kreskowy."
          }
        },
        "ps-AF" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بېلا بېل سندونه کېدای شي د بارکوډ متفاوتې بڼې او موقعیتونه ولري. د سند مخ او شا د بارکوډ لپاره وګورئ."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diferentes tipos de documentos podem ter diferentes formatos e localizações de códigos de barras. Procure um código de barras na frente e no verso do documento."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diferentes tipos de documentos podem ter formatos e localizações de código de barras diferentes. Verifique a frente e o verso do documento em busca de um código de barras."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diversele tipuri de documente pot avea formate și amplasări diferite ale codului de bare. Priviți atât partea din față, cât și din spate a documentului pentru a localiza codul de bare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разные типы документов могут иметь разные форматы и расположение штрихкодов. Штрихкод может находиться на лицевой или оборотной стороне документа."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "විවිධ වර්ගයේ ලේඛනවල විවිධ බාර්කෝඩ් ආකෘති තිබිය හැකි අතර, එය තිබෙන ස්ථානය ද වෙනස් විය හැක. බාර්කෝඩ් එකක් සොයා ගැනීමට ලේඛනයේ ඉදිරිපස සහ පිටුපස බලන්න."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rôzne typy dokumentov môžu mať rôzne formáty a umiestnenia čiarových kódov. Vyhľadajte čiarový kód na prednej alebo zadnej strane dokumentu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Različne vrste dokumentov imajo lahko različne oblike črtnih kod, ki so lahko na različnih mestih. Poiščite črtno kodo na sprednji ali zadnji strani dokumenta."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Različite vrste dokumenata mogu imati različite formate i položaje bar-koda. Potražite bar-kod na prednjoj i zadnjoj strani dokumenta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olika typer av dokument kan ha olika streckkodsformat, och placeringen kan variera. Titta på båda sidorna av dokumentet för att hitta streckkoden."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aina tofauti za hati zinaweza kuwa na miundo na sehemu tofauti ya msimbopau. Angalia upande wa mbele na nyuma wa hati ili uone msimbopau."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เอกสารประเภทต่างๆ อาจมีรูปแบบบาร์โค้ดและตำแหน่งที่แตกต่างกัน โปรดดูบาร์โค้ดที่ด้านหน้าและด้านหลังเอกสาร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farklı belge türlerinde barkod biçimleri ve yerleri farklı olabilir. Barkodu bulmak için belgenin ön ve arka yüzüne bakın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Різні типи документів можуть мати різні формати та розташування штрих-коду. Щоб знайти штрих-код, перегляньте лицьовий та зворотний бік документа."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مختلف اقسام کی دستاویزات میں بارکوڈ کے فارمیٹس اور مقامات مختلف ہو سکتے ہیں۔ بارکوڈ تلاش کرنے کے لیے دستاویز کے اگلے اور پچھلے رخ کو دیکھیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har xil turdagi hujjatlarda shtrixkod formati va joylashuvi turlicha boʻlishi mumkin. Shtrixkodni hujjatning old va orqa tomonidan qidiring."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các loại giấy tờ khác nhau có thể có định dạng và vị trí mã vạch khác nhau. Hãy xem mặt trước và mặt sau của giấy tờ để tìm mã vạch."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oríṣiríṣi irú àwọn ìwé àkọsílẹ̀ ló ní àgbékalẹ kóòdù onílà ọ̀tọ̀ọ̀tọ̀ àti àwọn ààyè tí ó le dúró sí. Wo iwájú àti ẹ̀yìn ìwé àkọsílẹ̀ náà fún kóòdù onílà kan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件类型不同，其条形码的格式和位置也可能不同。请在文件正反面寻找条形码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不同類型的文件可能會有不同的條碼格式和位置。請查看文件正反面，找到條碼。"
          }
        }
      }
    },
