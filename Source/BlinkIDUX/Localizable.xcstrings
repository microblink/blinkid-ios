        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ලේඛනයට හොඳින් ආලෝකය වැටෙන බවත්, සම්පූර්ණයෙන් පෙනෙන බවත්, දිලිසීමෙන් තොර බවත් සහතික කර ගන්න."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uistite sa, že je dokument dobre osvetlený, plne viditeľný a bez odleskov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poskrbite, da bo dokument dobro osvetljen, v celoti viden in brez odsevov."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uverite se da je dokument dobro osvetljen, potpuno vidljiv i bez odsjaja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollera att belysningen är god och att hela dokumentet är synligt och fritt från reflektioner."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hakikisha hati ina mwanga wa kutosha, inaonekana vizuri, na haina mng'ao."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจสอบว่าเอกสารของคุณเห็นได้ครบถ้วนดีและไม่มีแสงสะท้อน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belgenin iyi aydınlatılmış ve tamamen görünür olmasına ve belge üzerinde bir parlama olmamasına dikkat edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переконайтеся, що документ добре освітлений, повністю видимий та без відблисків."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یقینی بنائیں کہ دستاویز پر مناسب روشنی پڑ رہی ہو، وہ مکمل طور پر نظر آ رہی ہو اور اس پر چمک نہ ہو۔"
