        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hujjat yaxshi yoritilgan, toʻliq koʻrinadigan va unda yaltiroq joylar yoʻq ekanligiga ishonch hosil qiling."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
