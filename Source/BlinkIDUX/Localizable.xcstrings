    "mb_help_screen_barcode_msg1" : {
      "comment" : "scan.help.visibility.barcode.message: ",
      "extractionState" : "manual",
      "localizations" : {
        "ak" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hwɛ sɛ wo nsatea no bi nkata barkodu no fa bi. Afei nso, hwɛ sɛ hann biara nni barkodu no so a ɛmma wontumi nkan."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ባርኮዱን በጣትዎ አለመሸፈንዎን ያረጋግጡ። እንዲሁም በባርኮዱ ላይ የሚያርፉና ለማንበብ አስቸጋሪ ሊያደርጉ የሚችሉ የብርሃን ነጸብራቆችን ያስወግዱ።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احرص على عدم تغطية أجزاء من الباركود بأحد أصابعك. تجنّب أيضاً الانعكاسات الضوئية التي تظهر على الباركود وقد تعوق قراءته."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নিশ্চিত করুন যেন আপনার আঙুল দিয়ে বারকোডের কোনো অংশ ঢেকে না যায়। এছাড়া, বারকোডের ওপর পড়া কোনো প্রতিবিম্ব বা আলোর ঝলকানির দিকেও খেয়াল রাখবেন কারণ এর ফলে বারকোডটি পাঠযোগ্যতা হারাতে পারে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkontrolujte, zda část čárového kódu nezakrýváte prstem. Také dejte pozor na odlesky, které by mohly zapříčinit, že bude nečitelný."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sørg for, at du ikke dækker dele af stregkoden med en finger. Pas også på refleksioner henover stregkoden, da de kan gøre den ulæselig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achten Sie darauf, dass Sie keine Teile des Barcodes mit einem Finger verdecken. Achten Sie auch auf störende Lichtreflexe, die den Barcode überlagern und ihn unlesbar machen könnten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βεβαιωθείτε ότι δεν καλύπτετε μέρη της κάρτας με το δάχτυλό σας, Επίσης, προσέξτε τις αντανακλάσεις που καλύπτουν τον γραμμωτό κώδικα και μπορεί να τον καταστήσουν μη αναγνώσιμο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure you aren’t covering parts of the barcode with a finger. Also, watch out for reflections that go over the barcode and could make it unreadable."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure you aren’t covering parts of the barcode with a finger. Also, watch out for reflections that go over the barcode and could make it unreadable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegúrate de no cubrir partes del código de barras con el dedo. También ten cuidado con los reflejos que puedan cubrirlo y hacerlo ilegible."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegúrese de que no esté cubriendo partes del código de barras con un dedo. También, asegúrese que ningún reflejo se proyecte sobre el código de barras que pueda hacerlo ilegible."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hich bakhshi az barkod ra ba angosht napushanid. Moazebe baztabhayi bashid ke ruye barkod mioftand va momken ast an ra gheyr-e ghabele khandan konand."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmista, ettet peitä viivakoodia sormella. Varo myös, ettei viivakoodin päälle synny heijastuksia, jotka tekisivät siitä lukukelvottoman."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siguradhing hindi mo natatakpan ng daliri ang mga bahagi ng barcode. Tingnan din kung may mga reflection sa barcode na dahilan para hindi mabasa ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veillez à ce que votre doigt ne recouvre pas certaines parties du code-barres. Faites également attention aux reflets qui masquent le code-barres et peuvent le rendre illisible."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assurez-vous de ne pas couvrir certaines parties du code-barres avec un doigt. Faites également attention aux reflets qui pourraient se refléter sur le code-barres et le rendre illisible."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tabbatar da cewa ba a rufe wasu ɓangarorin barcode ɗin ba da yatsa. Bayan haka, a duba ko akwai wani dau na haske da ya hau kan barcode ɗin wanda kuma zai iya sa ba zai karantu ba."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ודאו שאינכם מכסים חלקים מהברקוד עם האצבע. כמו כן, היזהרו מהשתקפויות על גבי הברקוד שעלולות להפוך אותו לבלתי קריא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुनिश्चित करें कि आप उंगली से बारकोड के किसी हिस्से को ढक नहीं रहे हैं। साथ ही, उन प्रतिबिंबों से भी सावधान रहें जो बारकोड पर पड़ सकते हैं और उसे अपठनीय बना सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pripazite da ne prekrivate dijelove barkoda prstom. Također, pazite na refleksije koje mogu prelaziti preko barkoda i učiniti ga nečitljivim."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ügyeljen arra, hogy a vonalkód egyes részeit ne takarja el az ujjával. Ezenkívül ügyeljen a tükröződésekre, amelyek a vonalkódon áthaladnak, és olvashatatlanná tehetik azt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastikan jari Anda tidak menutupi bagian kode batang. Selain itu, hindari pantulan cahaya pada kode batang yang dapat menjadikannya tidak terbaca."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gakktu úr skugga um að þú hyljir ekki hluta strikamerkisins með fingri. Gáðu einnig að endurkasti ljóss sem fer yfir strikamerkið og gæti gert það ólæsilegt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accertati di non coprire parzialmente con un dito il codice a barre. Verifica inoltre che non ci siano riflessi sul codice a barre, che potrebbero comprometterne la leggibilità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バーコードの一部を指で覆わないようにしてください。また、バーコードにかかる反射にもご注意ください。読み取れなくなる可能性があります。"
          }
        },
        "ka-GE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დარწმუნდით, რომ თითით შტრიხკოდის ნაწილებს არ ფარავთ. ასევე, ფრთხილად იყავით ანარეკლებთანაც, რომლებიც შტრიხკოდზე გადადის და მის წაკითხვას შეუძლებელს ხდის."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Штрихкодтың қандай да бір бөліктерін саусағыңызбен жаппағаныңызға көз жеткізіңіз. Сондай-ақ штрихкодты жауып, оны оқуға болмайтын етуі мүмкін жарқыраудан сақ болыңыз."
          }
        },
        "km-KH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ត្រូវបា្រកដថា អ្នកមិនកំពុងគ្របបាំងផ្នែកនៃបារកូដដោយម្រាមដៃទេ។ ដូចគ្នាផងដែរ ប្រយ័ត្នចំពោះចំណាំងផ្លាតដែលទៅពីលើបារកូដ ហើយអាចធ្វើឲ្យវាមិនអាចអានបាន។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손가락으로 바코드 일부를 가리지 않도록 주의하세요. 또한 바코드 위에 반사광이 생기면 인식이 어려울 수 있으니 주의하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pārliecinieties, ka kādu svītrkoda daļu neaizsedzat ar pirkstu. Nodrošiniet arī, lai uz svītrkoda nebūtu atspīduma, jo šādā gadījumā svītrkods nebūs nolasāms."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastikan anda tidak menutup mana-mana bahagian kod bar dengan jari. Selain itu, berhati-hati dengan pantulan cahaya yang merentasi kod bar dan boleh menjadikannya tidak boleh dibaca."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sørg for at du ikke dekker til deler av strekkoden med fingrene, og at det ikke går lysskjær gjennom strekkoden som gjør den uleselig."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बारकोडको कुनै पनि भाग औँलाले नछोप्नुहोस्। साथै, बारकोडमा उज्यालो टल्किएको छ कि छैन विचार गर्नुहोस्, टल्केको भाग क्यामेराले चिन्न सक्दैन।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zorg ervoor dat je niet een deel van de barcode bedekt met een vinger. Pas ook op voor weerspiegelingen op de barcode, deze kunnen de code onleesbaar maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upewnij się, że nie zasłaniasz palcem żadnej części kodu kreskowego. Uważaj też na odbicia światła na kodzie kreskowym, które mogą utrudnić jego odczytanie."
          }
        },
        "ps-AF" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ډاډ حاصل کړئ چې د بارکوډ کومه برخه مو په ګوته پټه نکړئ. همدارنګه د وړانګو هغه غبرګون ته وګورئ چې پر بارکوډ راځي او کېدای شي بارکوډ و نه لوستل شي."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certifique-se de que não está a cobrir partes do código de barras com o dedo. Tenha também em atenção os reflexos sobre o código de barras e que poderão torná-lo ilegível."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certifique-se de não cobrir partes do código de barras com os dedos. Além disso, fique atento a reflexos sobre o código de barras, pois eles podem torná-lo ilegível."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asigurați-vă că nu acoperiți cu degetul anumite părți ale codului de bare. De asemenea, aveți grijă la reflexiile care apar pe codul de bare și l-ar putea face ilizibil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убедитесь, что вы не закрываете пальцем части штрихкода. Также избегайте бликов, которые могут закрыть штрихкод и сделать его нечитаемым."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබේ ඇඟිල්ලකින් බාර්කෝඩ් එකේ කොටස් ආවරණය නොවන බවට වග බලා ගන්න. එසේම බාර්කෝඩ් එකේ කොටස් කියවීම අපහසු කළ හැකි, ඒ මත ඇති වන පරාවර්තන පිළිබඳව අවධානයෙන් සිටින්න."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uistite sa, že časti čiarového kódu nezakrývate prstom. Dávajte si tiež pozor na odrazy, ktoré prechádzajú cez čiarový kód a môžu spôsobiť, že bude nečitateľný."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepričajte se, da s prstom ne prekrivate delov črtne kode. Pazite tudi na odseve, ki prekrivajo črtno kodo in jo lahko naredijo nečitljivo."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uverite se da prstom ne prekrivate delove barkoda. Pazite i na odsjaje na barkodu zbog kojih bi mogao da bude nečitljiv."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se till att du inte täcker delar av streckkoden med fingret. Se också upp för reflektioner som går över streckkoden och kan göra den oläslig."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hakikisha hujafunika sehemu za msimbopau kwa kidole. Pia, kuwa mwangalifu na mwanga unaoakisiwa unaopita juu ya msimbopau na unaweza kuufanya usisomeke."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจสอบให้แน่ใจว่าคุณไม่ได้ใช้นิ้วบังส่วนต่างๆ ของบาร์โค้ด นอกจากนี้ ระวังแสงสะท้อนบนบาร์โค้ดและอาจทำให้ไม่สามารถอ่านได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barkodun hiçbir bölümünü parmağınızla kapatmadığınızdan emin olun. Ayrıca, barkodun üzerinde parlayarak okunmasını engelleyebilecek ışık yansımalarına da dikkat edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переконайтеся, що ви не закриваєте частини штрих-коду пальцем. Також стежте за відблисками, які перекривають штрих-код і можуть зробити його нечитабельним."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یقینی بنائیں کہ آپ کی انگلی بار کوڈ کے کسی حصے کو چھپا نہ رہی ہو۔ اس کے علاوہ، اس عکس کا بھی دھیان رکھیں جو بار کوڈ پر پڑتا ہے اور اس کو پڑھنے میں دشواری پیدا کرتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barmogʻingiz shtrix-kodning ayrim qismlarini berkitib qoʻymasin. Shtrix-kod boʻylab oʻtadigan va uni tushunarsiz chiqishiga sabab boʻladigan akslanishlarga ham diqqat qarating."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đảm bảo bạn không dùng ngón tay che các phần của mã vạch. Ngoài ra, hãy coi chừng ánh sáng phản chiếu trên mã vạch có thể khiến mã vạch không thể đọc được."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ríi dájú pé o kò fi ìka bo àwọn apá ibì kankan lórí kóòdù onílà náà. Bákannáà, ṣọ́ra fún àwọn ìtànyòò tó kọjá lórí kóòdù onílà náà tí ó lè mú kí ó má ṣeé kà."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确保您的手指没有遮挡条形码。此外，请留意条形码上的反光，反光可能导致条形码无法读取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請確保手指沒有遮住條碼，並避免反光覆蓋條碼，以免無法辨識。"
          }
        }
      }
    },
    "mb_help_screen_barcode_msg2" : {
      "comment" : "scan.help.harsh_light.barcode.message: ",
      "extractionState" : "manual",
      "localizations" : {
        "ak" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hwɛ sɛ awia ntɔ so tee efisɛ ebetumi ama barkodu no fa bi mma yiye na ɛbɛyɛ den sɛ wobetumi askane. Sɛ wanhu barkodu no yiye a, kamara no ntumi nkenkan no yiye nso."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ቀጥተኛና ኃይለኛ ብርሃን በባርኮዱ ላይ ነጸብራቅ ሊፈጥርና ለመቃኘት አስቸጋሪ ስለሚሆን፣ እባክዎ እንዲህ ዓይነቱን ብርሃን ያስወግዱ። ባርኮዱ ለእርስዎ በግልጽ የማይታይ ከሆነ፣ ካሜራውም ሊያነበው አይችልም።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تجنَّب الضوء الساطع المباشر لأنه قد يُسبب وهجاً على الباركود ويُصعب مسحه. إذا لم ترى الباركود بوضوح، فقد لا تتمكن الكاميرا من قراءته."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সরাসরি ও তীব্র আলো এড়িয়ে চলুন, কারণ এটি বারকোডের ওপর তীব্র গ্লেয়ার তৈরি করতে পারে এবং স্ক্যান করা কঠিন করে তুলতে পারে। বারকোডটি যদি আপনার কাছে স্পষ্টভাবে দৃশ্যমান না হয়, তবে ক্যামেরাও সম্ভবত সেটি পড়তে পারবে না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyhněte se přímému ostrému světlu, protože by mohlo způsobit odlesky na čárovém kódu a ztížit jeho naskenování. Pokud čárový kód dobře nevidíte, nemusí být dobře čitelný ani pro fotoaparát."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undgå direkte skarpt lys, fordi det kan give genskin på stregkoden og gøre den vanskelig at scanne. Hvis du ikke kan se stregkoden tydeligt, kan kameraet måske heller ikke aflæse den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meiden Sie direktes, grelles Licht, da dieses Reflexionen auf dem Barcode verursachen und den Scanvorgang erschweren kann. Ist der Barcode für Sie nicht klar zu erkennen, ist er das für die Kamera möglicherweise auch nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποφύγετε το άμεσο, έντονο φως, επειδή μπορεί να δημιουργήσει αντανάκλαση στον γραμμωτό κώδικα και να καταστήσει δύσκολη τη σάρωσή του. Αν δεν μπορείτε να δείτε καθαρά των κώδικα, δεν θα είναι αναγνώσιμος και από την κάμερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoid direct harsh light because it can create glare on the barcode and make it difficult to scan. If the barcode isn’t clearly visible to you, the camera may not be able to read it either."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoid direct harsh light because it can create glare on the barcode and make it difficult to scan. If the barcode isn’t clearly visible to you, the camera may not be able to read it either."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita la luz directa fuerte, ya que puede generar reflejos en el código de barras y dificultar el escaneo. Si no ves el código de barras con claridad, es posible que la cámara tampoco pueda leerlo."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evite luz intensa de manera directa, ya que esto puede provocar reflejos en el código de barras y esto dificultara su lectura. Si el código de barras no es visible para usted, la cámara tampoco será capaz de leerlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az nur-e mostaghim va shadid parhiz konid, zira mitavanad roye barkod baztab ijad konad va eskan-e an ra دشvar konad. Agar barkod ra be-vazeh nemibinid, momken ast dorbin ham natavanad an ra bekhanad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vältä suoraa voimakasta valoa, koska se voi heijastua viivakoodista ja vaikeuttaa skannausta. Jos et näe viivakoodia selvästi, myöskään kamerasi ei pysty välttämättä lukemaan sitä."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iwasan ang direktang nakakasilaw na ilaw dahil maaari itong magdulot ng sinag sa barcode at magiging mahirap ang pag-scan. Kung hindi mo malinaw na nakikita ang barcode, posibleng hindi rin ito nababasa ng camera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Évitez la lumière directe et puissante, car celle-ci peut créer des reflets sur le code-barres et rendre sa lecture difficile. Si le code-barres n’est pas clairement visible, l’appareil photo risque de ne pas pouvoir le lire non plus."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Évitez la lumière directe et intense, car elle peut créer des reflets sur le code-barres et le rendre difficile à numériser. Si le code-barres n'est pas clairement visible pour vous, il se peut que l'appareil photo ne parvienne pas non plus à le lire."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kada a yi amfani da haske mai ƙarfi kai tsaye domin zai yi dau a kan barcode ɗin sannan zai sa ɗaukar hoton ya yi wahala. Idan ba kwa kallon barcode ɗin yadda ya kamata, to ba dole ba ne kamerarku ma ta iya karanta shi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הימנעו מאור ישיר חזק מכיוון שהוא עלול ליצור סנוור על הברקוד ולהקשות על הסריקה. אם הברקוד אינו נראה לכם ברור, ייתכן שגם המצלמה לא תוכל לקרוא אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सीधी तेज़ रोशनी से बचें, क्योंकि यह बारकोड पर चमक पैदा कर सकती है और उसे स्कैन करना मुश्किल बना सकती है। अगर बारकोड आपको साफ दिखाई नहीं दे रहा है, तो हो सकता है कैमरा भी उसे न पढ़ पाए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izbjegavajte izravnu jaku svjetlost jer može uzrokovati odsjaj na barkodu i otežati skeniranje. Ako vi ne vidite jasno barkod, ni kamera ga neće moći očitati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerülje a közvetlen, erős fényt, mert tükröződést okozhat a vonalkódon, és megnehezítheti a beolvasást. Ha a vonalkód az Ön számára sem látható tisztán, valószínűleg a kamera sem tudja beolvasni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindari cahaya terang langsung karena dapat menimbulkan efek silau sehingga kode batang sulit dipindai. Jika kode batang tidak terlihat jelas, kamera tidak dapat membacanya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forðastu beint skarpt ljós, því það getur valdið glampa á strikamerkinu og gert það erfitt að skanna. Ef þú sérð strikamerkið ekki greinilega, gæti myndavélin einnig átt erfitt með að lesið það."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita la luce intensa diretta, perché può creare riflessi sul codice a barre e rendere difficile la scansione. Se non riesci a vedere bene il codice a barre, neanche la fotocamera potrà vederlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強い光を直接当てるとバーコードに反射してスキャンできなくなる可能性があるため、避けてください。バーコードがはっきり目視できない場合、カメラも読み取れない可能性があります。"
          }
        },
        "ka-GE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მოერიდეთ პირდაპირ მკვეთრ განათებას, რადგან ის შტრიხკოდზე ანარეკლს აჩენს და მის დასკანერებას ართულებს. თუ შტრიხკოდი კარგად არ ჩანს, კამერამ შეიძლება ვერ დააფიქსიროს ის."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тіке түсетін жарық сәуледен аулақ болыңыз, себебі ол штрихкодқа шағылысып, оны сканерлеуді қиындатуы мүмкін. Егер штрихкод анық көрінбесе, камера оны оқи алмауы да ықтимал."
          }
        },
        "km-KH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ចៀសវាងពន្លឺផ្ទាល់ខ្លាំង ព្រោះវាអាចបង្កើតពន្លឺចាំងនៅលើបារកូដ ហើយធ្វើឲ្យវាពិបាកក្នុងការស្កេន។ ប្រសិនបើបារកូដមិនអាចមើលឃើញបានច្បាស់ចំពោះអ្នកទេ កាមេរ៉ាប្រហែលនឹងមិនអាចអានវាបានដែរ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "직사광선이나 강한 빛은 바코드에 반사를 일으켜 스캔을 어렵게 할 수 있으니 피하세요. 바코드가 육안으로도 잘 보이지 않는다면 카메라도 읽지 못할 수 있습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvairieties no tiešas spilgtas gaismas, jo tā var radīt atspīdumu uz svītrkoda, un to būs grūti skenēt. Ja jūs skaidri nesaredzat svītrkodu, arī kamera to nevarēs nolasīt."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jauhi cahaya yang boleh menyilaukan mata kerana cahaya tersebut boleh menyebabkan silau pada kod bar dan menyukarkan imbasan. Jika kod bar tidak jelas kelihatan kepada anda, kamera juga mungkin tidak dapat membacanya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unngå skarpt lys, da dette kan gjenspeiles i strekkoden og gjøre det vanskelig å skanne den. Hvis du ikke kan se strekkoden klart, er den heller ikke synlig for kameraet."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "धेरै चर्को उज्यालोमा स्क्यान नगर्नुहोस्, उज्यालो टल्केर बारकोड चिनिन गाह्रो हुन्छ। यदि तपाईं आफैँले बारकोड स्पष्टसँग देख्नुभएको छैन भने, क्यामेराले पनि त्यसलाई ठम्याउन सक्दैन।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probeer geen rechtstreeks fel light te gebruiken, want dit kan weerspiegelen op de barcode en deze kan daardoor moeilijk te scannen zijn. Als de barcode voor jou niet duidelijk zichtbaar is, dan is hij mogelijk voor de camera ook niet goed te lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unikaj bezpośredniego, ostrego światła, ponieważ może ono powodować odblaski na kodzie kreskowym i utrudniać jego skanowanie. Jeśli kod kreskowy nie jest dla Ciebie wyraźnie widoczny, aparat również może mieć problem z jego odczytaniem."
          }
        },
        "ps-AF" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "له مستقیمې او ځلانده روښنایئ څخه ډډه وکړئ ځکه چې دا پر بارکوډ غبرګون مومي او سکن کول ستونزمن کېږي. که بارکوډ تاسو ته په روښانه توګه د لیدلو وړ نه وي، کامره نشي کولای هغه په اسانۍ سره ولولي."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evite uma iluminação forte e direta, a qual poderá criar reflexos no código de barras e torná-lo difícil de digitalizar. Se o código de barras não for claramente visível, a câmara poderá também não conseguir digitalizá-lo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evite luzes fortes diretas, pois elas podem causar reflexos no código de barras e dificultar a digitalização. Se o código de barras não estiver claramente visível para você, a câmera provavelmente também não conseguirá lê-lo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evitați lumina puternică directă, deoarece aceasta poate crea reflexii pe codul de bare și poate îngreuna scanarea. În cazul în care codul de bare nu este clar vizibil pentru dumneavoastră, este posibil ca nici camera să nu îl poată citi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Избегайте прямого яркого света, так как он может создавать блики и затруднять сканирование. Если штрихкод вам плохо виден, камера также может не суметь его считать."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "බාර්කෝඩ් එක මත දිලිසීමක් ඇති වී එය ස්කෑන් කිරීමට අපහසු විය හැකි බැවින්, සෘජු රළු ආලෝකය වළක්වා ගන්න. ඔබට බාර්කෝඩ් එක පැහැදිලිව නොපෙනේ නම්, කැමරාවට ද එය කියවීමට නොහැකි විය හැක."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyhnite sa priamemu ostrému svetlu, pretože môže na čiarovom kóde vytvoriť odlesky a sťažiť jeho snímanie. Ak vy nevidíte jasne čiarový kód, nebude ho vidieť ani kamera."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izogibajte se močni neposredni svetlobi, saj lahko povzroči bleščanje na črtni kodi in oteži skeniranje. Če črtna koda ni jasno vidna vam, je morda tudi kamera ne bo mogla prebrati."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izbegavajte jaku direktnu svetlost jer može stvoriti odsjaj na bar-kodu i otežati skeniranje. Ako bar-kod nije jasno vidljiv vama, možda neće biti čitljiv ni kameri."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undvik direkt starkt ljus eftersom det kan skapa reflektioner på streckkoden och göra den svår att skanna. Om streckkoden inte är tydligt synlig för dig kanske kameran inte heller kan läsa den."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Epuka mwanga mkali wa moja kwa moja kwa sababu unaweza kusababisha mng'ao mkali kwenye msimbopau na kufanya iwe vigumu kuskani. Kama huoni vizuri msimbopau, kamera vilevile huenda isiweze kuusoma."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หลีกเลี่ยงแสงจ้าที่ส่องตรงๆ เพราะแสงสะท้อนบนบาร์โค้ดอาจทำให้สแกนไม่ได้ หากคุณเห็นว่าบาร์โค้ดไม่ชัดเจน กล้องก็อาจจะมองไม่เห็นเช่นกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doğrudan ve yoğun ışıktan kaçının; bu durum barkodun üzerinde parlama yaparak taranmasını zorlaştırır. Eğer barkod gözünüze net görünmüyorsa, büyük ihtimalle kamera da okuyamayacaktır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уникайте прямого яскравого світла, оскільки воно може створювати відблиски на штрих-коді й ускладнювати його сканування. Якщо штрих-код чітко не видно вам, камера також може не зчитати його."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "براہ راست تیز روشنی سے گریز کریں کیونکہ اس سے بار کوڈ پر چمک پیدا ہو سکتی ہے اور اسے اسکین کرنا مشکل ہو جاتا ہے۔ اگر آپ کو بار کوڈ واضح طور پر نظر نہیں آ رہا، تو ممکن ہے کہ کیمرہ بھی اسے پڑھ نہ سکے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yorqin yorugʻlik bevosita tushmasin, chunki u shtrix-kodda aks etadi va skanerlashni qiyinlashtirishi mumkin. Shtrix-kod sizga aniq koʻrinmayotgan boʻlsa, kamera uni yaxshi ololmayotgan boʻlishi mumkin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tránh ánh sáng gay gắt trực tiếp vì nó có thể tạo ra lóa sáng trên mã vạch và khiến việc quét trở nên khó khăn. Nếu mã vạch không rõ ràng với bạn, camera cũng có thể không đọc được."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yẹra fún ìmọ́lẹ̀ tó lágbára ní tààrà nítorí ó lè mú kí ìtànyòò wà lórí kóòdù onílà náà àti pé ó lè mú kí ó ṣòro látí ṣe àyẹ̀wò . Tí kóòdù onílà náà ò bá hàn sí ọ ní kedere, ó lè ṣòro fún kámẹ́rà náà láti gbée jáde."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "避免强光直射，因为这会在条码上产生眩光，导致难以扫描。如果您看不清条形码，相机也可能无法读取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "避免強烈光源直接照射條碼，以免產生反光而影響掃描。若您看不清楚條碼，相機可能也無法看清。"
          }
        }
      }
    },
    "mb_help_screen_barcode_msg3" : {
      "comment" : "scan.help.blur.barcode.message: ",
      "extractionState" : "manual",
      "localizations" : {
        "ak" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wobɛma fon no ne barkodu no agyina faako bere a wo skane no. Sɛ wokeka wo ho a ebetumi ama mfonini no ani ayɛ kusuu na ɛbɛyɛ den sɛ wobetumi akan barkodu no."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "በሚቃኙበት ጊዜ ስልኩን እና ካርዱን ጸንተው ይዘው ለማቆየት ይሞክሩ። አንዱን ማንቀሳቀስ ምስሉን ሊያደበዝዝ እና ባርኮዱን የማይነበብ እንዲሆን ያደርገዋል።"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حاول إبقاء الهاتف والباركود ثابتين في المسح. تحريك أي منهما قد يسبب تشويش الصورة ويجعل قراءة الباركود صعبة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্ক্যান করার সময় ফোন এবং বারকোড উভয়ই স্থির রাখার চেষ্টা করুন। এর যেকোনো একটি নড়াচড়া করলে ছবিটি ঝাপসা হয়ে যেতে পারে এবং বারকোডটি পড়া কঠিন হয়ে পড়তে পারে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při skenování se snažte držet telefon a čárový kód v klidu. Pohyb může obraz rozmazat a způsobit, že čárový kód nebude čitelný."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøv at holde telefonen og stregkoden stille, mens du scanner. Bevægelse kan gøre billedet uskarpt, så stregkoden bliver svær at aflæse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versuchen Sie, das Telefon und den Barcode während des Scanvorgangs ruhig zu halten. Jede Bewegung kann das Bild unscharf und den Barcode schwer lesbar machen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσπαθήστε να κρατήσετε το τηλέφωνο και τον γραμμωτό κώδικα ακίνητα κατά τη σάρωση. Η μετακίνηση οποιουδήποτε από τα δύο μπορεί να θολώσει την εικόνα και να καταστήσει τον γραμμωτό κώδικα δυσανάγνωστο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try to keep the phone and the barcode still while scanning. Moving either can blur the image and make the barcode difficult to read."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try to keep the phone and the barcode still while scanning. Moving either can blur the image and make the barcode difficult to read."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intenta mantener el teléfono y el código de barras estables mientras escaneas. Si se mueve alguno de los dos, la imagen puede salir borrosa y el código de barras podría no leerse correctamente."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trate de mantener el teléfono y el código de barras quietos mientras escanea. Mover cualquiera de los dos puede hacer que la imagen se vea borrosa y esto dificultara la lectura del código de barras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kushesh konid dar hengam-e esken telefon va barkod ra bi-harekat negah darid. Harekat-e har kodam mitavanad tasvir ra tar konad va khandan-e barkod ra doshvar konad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yritä pitää puhelin ja viivakoodi paikallaan skannauksen aikana. Jommankumman liikuttaminen voi sumentaa kuvaa ja vaikeuttaa viivakoodin lukemista."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panatilihing hindi gumagalaw ang telepono at barcode habang nag-i-scan. Maaaring maging malabo ang larawan at hindi mabasa ang barcode kapag gumagalaw."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essayez de garder le téléphone et le code-barres immobiles pendant le scan. Tout mouvement peut brouiller l’image ou rendre le code-barres difficile à lire."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essayez de maintenir le téléphone et le code-barres immobiles pendant la numérisation. Tout mouvement peut rendre l'image floue et le code-barres difficile à lire."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A daina jijjiga wayar da barcode ɗin yayin da ake ɗaukar hoto. Motsawa zai sa hoton ya yi dishi-dishi sannan zai sa barcode ɗin ya yi wahalar karantawa."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נסו לדאוג שהטלפון והברקוד יישארו יציבים בזמן הסריקה. תזוזה של כל אחד מהם עלולה לטשטש את התמונה ולהקשות על קריאת הברקוד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्कैन करते समय फ़ोन और बारकोड दोनों को यथासंभव स्थिर रखें। इनमें से किसी को भी हिलाने से तस्वीर धुंधली हो सकती है और बारकोड पढ़ना मुश्किल हो सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokušajte za vrijeme skeniranja što mirnije držati telefon i barkod. Pomicanjem može doći do zamućenja slike zbog čega barkod postaje nečitljiv."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Próbálja mozdulatlanul tartani a telefont és a vonalkódot a beolvasás alatt. Ha valamelyik mozog, elmosódhat a kép, és a vonalkód nehezen olvashatóvá válhat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usahakan ponsel dan kode batang tidak bergerak saat memindai. Jika bergerak, gambar menjadi buram dan kode batang sulit dibaca."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reyndu að halda símanum og strikamerkinu kyrru meðan þú skannar. Ef annað hvort hreyfist getur myndin orðið óskýr og strikamerkið orðið erfitt að lesa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca di tenere fermo il telefono e il codice a barre durante la scansione. Muoverli può sfocare l'immagine e rendere difficile da leggere il codice a barre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキャン中はスマートフォンとバーコードを動かさないでください。片方でも動くと画像がぼやけ、バーコードが読み取れなくなる恐れがあります。"
          }
        },
        "ka-GE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დასკანერებისას ეცადეთ არ გაამოძრაოთ ტელეფონი და შტრიხკოდი. გამოძრავების შემთხვევაში ფოტო შეიძლება დაიბუროს და შტრიხკოდი გარჩევადი არ იყოს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сканерлеу кезінде телефон мен штрихкодты қозғалтпай ұстауға тырысыңыз. Олардың кез келгенінің қозғалысы кескіннің бұлыңғырлануына әкеліп, штрихкодты оқуды қиындатуы мүмкін."
          }
        },
        "km-KH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "សូមព្យាយាមរក្សាទូរសព្ទ និងបារកូដឲ្យនៅនឹងពេលកំពុងស្កេន។ ការធ្វើចលនាណាអាចធ្វើឲ្យរូបភាពព្រាល ហើយធ្វើឲ្យពិបាកអានបារកូដ។"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스캔하는 동안 휴대폰과 바코드를 모두 움직이지 않도록 하세요. 어느 쪽이든 움직이면 이미지가 흐려져 바코드를 읽기 어려울 수 있습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skenēšanas laikā nekustiniet tālruni un svītrkodu. Pretējā gadījumā attēls var būt izplūdis, un svītrkodu būs grūti nolasīt."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuba kekalkan kedudukan telefon dan kod bar semasa mengimbas. Jika salah satu bergerak, imej boleh menjadi kabur dan menyebabkan kod bar sukar dibaca."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold telefonen og strekkoden i ro når du skanner. Bevegelse kan gjøre bildet uskarpt og føre til at strekkoden blir vanskelig å lese."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्क्यान गर्दा फोन र बारकोड दुवैलाई नहल्लाई राख्ने प्रयास गर्नुहोस्। कुनै पनि वस्तु हल्लिनाले तस्बिर धमिलो हुन सक्छ र बारकोड पढ्न गाह्रो हुन सक्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probeer de telefoon en de barcode niet te bewegen tijdens het scannen. Door beweging kan de afbeelding onscherp worden en de gegevens op het document onleesbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas skanowania staraj się trzymać telefon i kod kreskowy nieruchomo. Poruszanie którymkolwiek z nich może rozmyć obraz i utrudnić odczytanie kodu kreskowego."
          }
        },
        "ps-AF" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هڅه وکړئ د سکن کولو پر مهال ټلیفون او بارکوډ و نه خوځوئ. د هغوی خوځول د انځور د تت کېدو لامل کېږي او د بارکوډ لوستل ستونزمنېږي."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tente manter o telemóvel e o código de barras imóvel enquanto digitaliza, caso contrário a imagem poderá ficar desfocada e o código de barras poderá ficar desfocado e ser difícil de ler."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tente manter o celular e o código de barras imóveis durante a digitalização. Movimentos de qualquer um deles podem desfocar a imagem e dificultar a leitura do código de barras."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încercați să mențineți telefonul și codul de bare nemișcate în timpul scanării. Mișcarea oricăruia dintre ele poate face ca imaginea să fie neclară și poate îngreuna citirea codului de bare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Старайтесь во время сканирования держать телефон и штрихкод неподвижно. Движение может привести к размытию и затруднить считывание штрихкода."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ස්කෑන් කරන අතරතුර දුරකථනය සහ බාර්කෝඩ් එක නොසෙල්වෙන සේ තබා ගැනීමට උත්සාහ කරන්න. මින් එකක් හෝ සෙලවීම රූපය අපැහැදිලි වී බාර්කෝඩ් එක කියවීමට අපහසු වීමට හේතු විය හැක."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počas snímania sa snažte nehýbať telefónom a čiarovým kódom. Pohyb môže rozmazať obraz a spôsobiť, že sa čiarový kód nebude dať prečítať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med skeniranjem poskusite telefon in črtno kodo držati pri miru. Premikanje lahko zamegli sliko in oteži branje črtne kode."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Držite telefon i barkod mirno tokom skeniranja. Pomeranje bilo kog od njih može zamutiti sliku i otežati očitavanje barkoda."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Försök att hålla telefonen och streckkoden stilla medan du skannar. Att röra sig kan göra bilden suddig och göra streckkoden svår att läsa."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaribu kuhakikisha simu na msimbopau havisongi unaposkani. Kusonga kunaweza kufanya picha isionekane vizuri na kufanya iwe vigumu msimbopau kusomeka."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พยายามถือโทรศัพท์และบาร์โค้ดให้นิ่งขณะสแกน การเคลื่อนไหวอาจทำให้ภาพพร่ามัวและทำให้อ่านข้อมูลบาร์โค้ดไม่ออก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarama sırasında telefonu ve barkodu sabit tutmaya özen gösterin. Herhangi birinin hareket etmesi görüntüyü bulanıklaştırıp barkodun okunmasını zorlaştırabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Під час сканування намагайтеся тримати телефон і штрих-код нерухомими. Рух одного з них може розмити зображення та ускладнити зчитування штрих-коду."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسکین کرتے وقت فون اور بار کوڈ دونوں کو ساکن رکھنے کی کوشش کریں۔ ان میں سے کسی ایک کی بھی حرکت تصویر کو دھندلا کر سکتی ہے اور بار کوڈ پڑھنے میں دشواری پیش آ سکتی ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skanerlayotganda telefon va shtrix-kodni qimirlatmang. Qimirlash rasm xira olinishiga va shtrix-kod tushunarsiz chiqishiga sabab boʻlishi mumkin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cố gắng giữ yên điện thoại và mã vạch trong khi quét. Di chuyển có thể làm mờ hình ảnh hoặc khiến mã vạch khó đọc."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gbìyànjú láti mú fóònù àti kóòdù onílà náà dúró nígbà ṣíṣe àyẹ̀wò. Sí sún kiri lè fa kí àwòrán náà rí bàìbàì àti kí kóòdù onílà náà ṣòro látí kà."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描时尽量保持手机和条形码不动。移动可能导致图像模糊，使条形码难以读取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "掃描時盡量保持裝置及條碼穩定。任何移動可能會使圖像模糊，導致無法辨識條碼。"
          }
        }
      }
    },
